# Copy this file to .env and fill in real values. Never commit .env.
# In Docker/Coolify, set these via the Coolify UI or a separate .env file.
NODE_ENV=development
PORT=8888

# PostgreSQL connection string. The database must already exist (migrations
# will create the schema but not the database itself). For a local Postgres:
#   DATABASE_URL=postgres://user:password@localhost:5432/chorusify
# For Docker/Coolify, set this via the Coolify UI or a separate .env file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chorusify

# Random secrets used to sign session cookies and CSRF tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
CSRF_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slash).
# Required in development (frontend runs on a different port); optional in production
# when the frontend is served by the same Express process (npm run build:full && npm start).
# In Docker/Coolify with the frontend & API on the same origin, leave this empty.
CORS_ORIGIN=http://localhost:5174

# The only admin account. Unset means nobody is admin.
ADMIN_EMAIL=
# Registration refuses ADMIN_EMAIL (addresses are unverified). Set true only to create that account.
ADMIN_REGISTRATION_OPEN=false
