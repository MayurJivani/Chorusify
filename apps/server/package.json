{
  "name": "@chorusify/server",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\" && node -e \"require('fs').existsSync('public')&&require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "lint": "eslint --no-error-on-unmatched-pattern 'src/**/*.js' 'test/**/*.js' --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate-sqlite": "tsx ../../scripts/migrate-sqlite-to-postgres.ts",
    "curate:songs": "tsx ../../scripts/curate-songs.ts",
    "reverify:songs": "tsx ../../scripts/reverify-songs.ts",
    "change-daily-puzzle": "tsx ../../scripts/change-daily-puzzle.ts",
    "export:pool": "tsx src/db/exportPool.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "uuid": "^14.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
