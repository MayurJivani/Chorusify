http://chorusify.com, http://chorus.futile.studio {
	import common
	# The room QR scanner needs the camera and knock-to-buzz the microphone, on this origin only.
	header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
	# Multiplayer rooms ride a WebSocket; buffered, rounds reveal at different moments on each phone.
	reverse_proxy 127.0.0.1:3001 {
		flush_interval -1
	}
}
